#!/usr/bin/env bash
# Blocks commits that would publish Instagram session material (this repo is public).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
export LC_ALL=C

fail=0

while IFS= read -r -d '' file; do
  case "$file" in
    *.har|*.session|*cookies*.txt|session*.json|*/session*.json)
      echo "pre-commit: refusing to commit $file (looks like session material)"
      fail=1
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

diff_out="$(git diff --cached --text -U0 --diff-filter=ACMR)"
added="$(grep -aE '^\+' <<<"$diff_out" | grep -avE '^\+\+\+ [ab]/[^ ]*$' || true)"
if grep -qaEi 'session_?id["'\'']*[[:space:]]*[:=][[:space:]]*["'\'']*[0-9]+(%3A|:)[A-Za-z0-9]{10,}' <<<"$added"; then
  echo "pre-commit: staged changes contain a sessionid value"
  fail=1
fi
if grep -qaEi '(set-)?cookie: *[a-z0-9_-]+=' <<<"$added"; then
  echo "pre-commit: staged changes contain a Cookie header with a value"
  fail=1
fi

if grep -qaEi '["'"'"']*name["'"'"']*[[:space:]]*:[[:space:]]*["'"'"']*(sessionid|csrftoken|ds_user_id)["'"'"']*' <<<"$added"; then
  echo "pre-commit: staged changes contain an exported cookie (JSON)"
  fail=1
fi
if grep -qaE $'\t(sessionid|csrftoken|ds_user_id)\t' <<<"$added"; then
  echo "pre-commit: staged changes contain an exported cookie (Netscape format)"
  fail=1
fi
if grep -qaEi 'csrf_?token["'\'']*[[:space:]]*[:=][[:space:]]*["'\'']*[A-Za-z0-9]{16,}' <<<"$added"; then
  echo "pre-commit: staged changes contain a csrftoken value"
  fail=1
fi

exit "$fail"
